# Server
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fraudshield?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace_with_a_64_character_random_hex_string
JWT_EXPIRES_IN=7d

# CORS (Frontend URL e.g. https://fraudshield.vercel.app or comma-separated)
CLIENT_URL=https://your-frontend-app.vercel.app

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
